#!/bin/sh
# DashFloat is a single-user CLI/TUI: no distribution, no epmd, and no
# node-name collision when two instances run on one machine (ADR 0010).
export RELEASE_DISTRIBUTION="${RELEASE_DISTRIBUTION:-none}"

# The VM dlopens libsctp.so.1 at init when built with SCTP support and prints
# an `=ESOCK WARNING` block to stdout on every boot without it. The directory
# only exists when the release step bundled the library, so macOS (no SCTP
# support) is unaffected. See ADR 0010.
if [ -d "$RELEASE_ROOT/lib/sctp" ]; then
  export LD_LIBRARY_PATH="$RELEASE_ROOT/lib/sctp${LD_LIBRARY_PATH:+:$LD_LIBRARY_PATH}"
fi
